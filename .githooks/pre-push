#!/bin/sh
# Runs the guardrail checks (GUARDRAILS.md, scripts/check.py) on everything being
# pushed, and refuses the push if a rule is broken or a flagged change has no
# owner sign-off ("Approved-Rule: <ID> — reason" in a commit message).
# Enabled once per clone with:  git config core.hooksPath .githooks
z40=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue            # deleting a branch
  if [ "$remote_sha" = "$z40" ]; then               # new branch: compare with main
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
  else
    base=$remote_sha
  fi
  if ! python3 scripts/check.py ${base:+--base "$base"} --strict; then
    echo
    echo "Push refused by the guardrail checks (details above)."
    exit 1
  fi
done
exit 0
