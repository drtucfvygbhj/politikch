  "monitorDomains": ["politikch.ch", "www.politikch.ch", "politicsch.ch", "politicach.ch", "politiquech.ch"],

  "voteinfoHosts": ["ogd-static.voteinfo-app.ch", "dam-api.bfs.admin.ch"],

  "csp": {
    "_about": "SEC-03 / PRIV-02. The exact published policy. Any change is flagged; loosening is blocked.",
    "default-src": ["'self'"],
    "script-src": ["'self'"],
    "style-src": ["'self'", "'unsafe-inline'"],
    "img-src": ["'self'", "data:"],
    "font-src": ["'self'"],
    "connect-src": ["'self'", "https://politikch-analytics.soft-hill-f9fb.workers.dev"],
    "base-uri": ["'self'"],
    "form-action": ["'none'"],
    "object-src": ["'none'"]
  },

  "storageKeys": {
    "_about": "PRIV-03 (FMG Art. 45c). Every key the site stores on a visitor's device, and where the Privacy page describes it.",
    "politikch-lang": "privacy.p.storage",
    "politikch-votes": "privacy.p.storage",
    "politikch-votes-pushed": "poll only (POLL_API); must be added to privacy.p.storage before the poll is switched on",
    "politikch-analytics-off": "privacy.p.analytics2"
  },

  "analytics": {
    "_about": "PRIV-05. What the Worker may record; must match the Privacy page.",
    "events": ["lang", "search", "vote", "share", "outbound", "vote_open", "contact", "glossary"],
    "eventsColumns": ["id", "ts", "day", "hour", "kind", "route", "entry", "name", "prop", "ref", "utm_source", "utm_medium", "utm_campaign", "country", "region", "city", "device", "browser", "os", "screen", "lang", "blang", "visitor", "duration"],
    "rawRetentionDays": "7",
    "optOutMarkers": ["globalPrivacyControl", "doNotTrack", "webdriver", "localhost", "'analytics'"]
  },

