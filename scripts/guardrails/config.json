    "swissvotes.ch": {"role": "fetch", "owner": "Année Politique Suisse, University of Bern", "use": "party recommendations, EN short titles, brochure PDFs", "licence": "CC BY 4.0 (dataset); brochure text URG Art. 5", "commercial": "yes with credit", "crawlDelay": 10, "robots": "Crawl-delay: 10; Disallow: /auth/", "verified": "2026-09-24"},
    "politikfinanzierung.efk.admin.ch": {"role": "fetch", "owner": "Swiss Federal Audit Office (EFK)", "use": "party and campaign financing", "licence": "terms_open", "commercial": "yes", "ckan": "politikfinanzierung", "terms": ["terms_open"], "robots": "none (404)", "verified": "2026-09-24"},
