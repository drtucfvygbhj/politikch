# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local server / logs
*.log

# Node (only if you later add tooling)
node_modules/

# Claude Code local session settings (machine-specific, not shared)
.claude/settings.local.json
__pycache__/

# Local AI-maintenance review queue (staged proposals, not shared)
review/

# Manually-added official brochure PDFs (large; only used at build time to add
# native Italian). The extracted arguments in data/overviews/ ARE committed.
data/brochures/*.pdf

# Security/compliance audit notes (never tracked or deployed)
audit/

# CI deploy staging directory
_site/

# Analytics Worker: local Wrangler state and local secrets
analytics-worker/.wrangler/
analytics-worker/.dev.vars
